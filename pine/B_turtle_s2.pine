//@version=6
strategy("B Turtle System 2 XAUUSD", overlay=true, pyramiding=1, process_orders_on_close=true,
         commission_type=strategy.commission.percent, commission_value=0.05,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         margin_long=100, margin_short=100)
// Turtle System 2 (Richard Dennis): 55-day breakout entry, 20-day opposite breakout exit, 2N stop (N = ATR 20).
entryLen = input.int(55, "Entry breakout days")
exitLen = input.int(20, "Exit breakout days")
nMult = input.float(2.0, "Stop in N")
hiE = ta.highest(high, entryLen)[1]
loE = ta.lowest(low, entryLen)[1]
hiX = ta.highest(high, exitLen)[1]
loX = ta.lowest(low, exitLen)[1]
n = ta.atr(20)
flat = strategy.position_size == 0
longEntry = flat and close > hiE
shortEntry = flat and close < loE
var float sl = na
if longEntry
    strategy.entry("L", strategy.long)
    sl := close - nMult * n
    strategy.exit("LX", from_entry="L", stop=sl)
if shortEntry
    strategy.entry("S", strategy.short)
    sl := close + nMult * n
    strategy.exit("SX", from_entry="S", stop=sl)
if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=sl)
    if close < loX
        strategy.close("L")
if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=sl)
    if close > hiX
        strategy.close("S")
plot(longEntry ? 1 : 0, title="longEntry")
plot(shortEntry ? 1 : 0, title="shortEntry")
