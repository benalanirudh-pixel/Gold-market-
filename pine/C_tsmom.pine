//@version=6
strategy("C Time-series momentum XAUUSD", overlay=true, pyramiding=1, process_orders_on_close=true,
         commission_type=strategy.commission.percent, commission_value=0.05,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         margin_long=100, margin_short=100)
// Time-series momentum (Moskowitz, Ooi & Pedersen 2012): long if price is above its level `lookback` days ago, else short.
lookback = input.int(63, "Lookback (trading days)")
up = close > close[lookback]
dn = close < close[lookback]
if up and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
if dn and strategy.position_size >= 0
    strategy.entry("S", strategy.short)
plot(up ? 1 : 0, title="longState")
